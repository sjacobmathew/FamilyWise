  "results": {
    "sanguine": {
      "title": "Sanguine — The Connector",
      "inFamily": "Brings energy into a room, makes everyone laugh, turns errands into an adventure. Struggles with follow-through and can talk over quieter family members without meaning to.",
      "strengths": [
        "warm",
        "spontaneous",
        "quick to forgive",
        "natural storyteller",
        "makes others feel included"
      ],
      "growthEdges": [
        "finishing what they start",
        "sitting with repetitive or boring tasks",
        "listening as much as talking"
      ],
      "tips": [
        "Give them your full attention when they're talking — being heard matters more to them than being right",
        "Keep instructions short and let them add their own flair",
        "Don't take a mood swing personally; it passes in minutes",
        "Pair them with tasks that involve people, not solo paperwork"
      ]
    },
    "choleric": {
      "title": "Choleric — The Driver",
      "inFamily": "Organizes the road trip, sets the house rules, gets things done when everyone else is stalling. Can come across as bossy or impatient with slower processes.",
      "strengths": [
        "decisive",
        "resilient",
        "natural problem-solver",
        "protective of the people they love"
      ],
      "growthEdges": [
        "slowing down for others' pace",
        "softening delivery",
        "accepting help without seeing it as losing control"
      ],
      "tips": [
        "Get to the point — they respect efficiency over small talk",
        "Let them own a task fully rather than micromanaging their process",
        "Give credit for what they accomplish; it's how they feel valued",
        "Pick your battles — arguing every point wears them down for the ones that matter"
      ]
    },
    "melancholic": {
      "title": "Melancholic — The Thinker",
      "inFamily": "Remembers everyone's birthday, notices when someone's upset before they say anything, needs a real reason before agreeing to a plan. Can seem withdrawn or overly critical under stress.",
      "strengths": [
        "thoughtful",
        "loyal",
        "high standards",
        "deeply empathetic once they open up"
      ],
      "growthEdges": [
        "not spiraling on mistakes",
        "asking for reassurance instead of assuming the worst",
        "accepting \"good enough\""
      ],
      "tips": [
        "Don't rush them into decisions — give processing time",
        "Respect their need for alone time; it's not rejection",
        "Be specific and sincere with praise — vague compliments feel hollow to them",
        "Give advance notice of changes to plans; surprises unsettle them"
      ]
    },
    "phlegmatic": {
      "title": "Phlegmatic — The Steady One",
      "inFamily": "Diffuses tension, goes along with whatever the group wants, rarely raises their voice. Can avoid conflict to the point of not sharing what they actually want.",
      "strengths": [
        "calm",
        "dependable",
        "easy to live with",
        "a natural mediator"
      ],
      "growthEdges": [
        "voicing their own preferences, not just keeping the peace at their own expense",
        "taking initiative instead of waiting"
      ],
      "tips": [
        "Ask directly what they want — they won't always volunteer it",
        "Don't mistake their calm for not caring",
        "Give them time to warm up to change rather than springing it on them",
        "Check in privately — they're less likely to speak up in a group setting"
      ]
    }
